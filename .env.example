# 本模板只含占位符，可安全提交；复制为 .env 后填写真实值（.env 已被 .gitignore 忽略）。
# 首次运行配置步骤见 README「2.1 首次运行配置清单」。
DRAWING_GRAPH_DATA_ROOT=C:\path\to\图块图谱构建\data
DRAWING_GRAPH_PROJECT_SLUG=road-project
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-password>
DRAWING_GRAPH_BATCH_SIZE=500
DRAWING_GRAPH_LOG_LEVEL=INFO

# Optional: Qwen/DashScope multimodal recognition provider.
# Keep real values only in local environment files that are ignored by git.
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DRAWING_GRAPH_RECOGNITION_PROVIDER=qwen
DRAWING_GRAPH_QWEN_MODEL=qwen3-vl-plus
DRAWING_GRAPH_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DRAWING_GRAPH_QWEN_TIMEOUT_SECONDS=60

NEO4J_TEST_URI=bolt://127.0.0.1:7687
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=<test-password>

# 多模态识别执行层（04）非 secret 配置
DRAWING_GRAPH_RECOGNITION_MAX_ATTEMPTS=3
DRAWING_GRAPH_RECOGNITION_STRUCTURE_REPAIR_ATTEMPTS=1
DRAWING_GRAPH_RECOGNITION_DEADLINE_SECONDS=60
DRAWING_GRAPH_RECOGNITION_BASE_BACKOFF_MS=250
DRAWING_GRAPH_RECOGNITION_MAX_BACKOFF_MS=2000
DRAWING_GRAPH_RECOGNITION_JITTER_RATIO=0.1
DRAWING_GRAPH_RECOGNITION_MAX_IMAGE_BYTES=20971520
DRAWING_GRAPH_RECOGNITION_MAX_IMAGE_PIXELS=50000000
DRAWING_GRAPH_RECOGNITION_MAX_PREPARED_SIDE=2048
DRAWING_GRAPH_RECOGNITION_PREPROCESSING_VERSION=preprocess-v1
# DRAWING_GRAPH_RECOGNITION_RATE_CARD_PROFILE=  # 可选；留空会触发 config 校验错误，不需要时保持注释
